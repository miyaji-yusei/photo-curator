// Photo Curator の中核。**判断が絡むものだけを置く。**
//
// バイトを読む・画像をデコードする・画面に出すのは各環境の仕事。
// ここに置くのは「同じ入力なら同じ答えでなければ困るもの」だけ。

namespace photo_curator_core {
    // 2 枚が同じ連写か。**時間の近さと見た目の近さの両方**で決める。
    boolean is_same_burst(BurstPair pair, BurstThreshold threshold);

    // 撮影順に並んだ写真を、連写のまとまりへ畳む。
    sequence<BurstGroup> group_bursts(
        sequence<PhotoRef> photos,
        BurstThreshold threshold,
        sequence<PairOverride> overrides
    );

    // dHash どうしの距離。**0 が同一。** 版が違うものは比べない。
    u32 hash_distance(string left, string right);

    // 9x8 に潰し終えた輝度から dHash を作る。
    string? d_hash_from_luma(sequence<u8> luma);

    // 任意の大きさの輝度から dHash を作る。**縮小もここでやる。**
    // 各環境の縮小器に任せると値が揃わない（実測で距離 5 の差が出た）。
    string? d_hash_from_gray(sequence<u8> gray, u32 width, u32 height);

    // 学習の答えから「見た目が近い」の境目を決める。答えが無ければ既定値。
    // 食い違ったときは切る側に倒す（間違えて繋ぐ方が高くつくため）。
    u32 learn_distance(sequence<BurstAnswer> answers, u32 fallback);

    // ---- 選別 ----
    // ラウンドを始める。連写のまとめは中で済ませる。
    Session start_round(
        sequence<PhotoRef> photos,
        u32 group_size,
        i32 target_star,
        boolean group_bursts,
        BurstThreshold threshold,
        sequence<PairOverride> overrides
    );

    // いまのグループを確定して次へ。**選ばれたものは星が 1 つ上がる。**
    Session advance(Session session, sequence<string> selected);

    // 直前の判断を取り消す。星も戻る。★5 で確定した分は元の星に返る。
    Session undo(Session session);

    // ★5 を付けてそのグループを確定する。**以降のラウンドには出さない。**
    // 画面に出ていない写真を指されたら何もしない。
    Session keep_top(Session session, string path);

    Session keep_and_top(Session session, sequence<string> selected, string path);

    // 連写のまとまりで、画面に出す 1 枚を選び直す。星は動かさない。
    // 選び直せないとき（まとまりでない・仲間でない・もう見終わった）は null。
    Session? set_representative(Session session, string shown, string wanted);

    // 一度に見比べる枚数を変える。いまのグループにすぐ効く。
    // 足りなければ次から補い、余れば次へ押し出す。
    Session resize(Session session, u32 group_size);

    // まとめ方を変えて、いまのラウンドを組み直す。**その場で反映する。**
    // 組み直すのはまだ判断していない写真だけ。決めた分は星として残る。
    Session regroup(
        Session session,
        sequence<PhotoRef> photos,
        boolean group_bursts,
        BurstThreshold threshold,
        sequence<PairOverride> overrides
    );

    // 次のラウンドへ。**進めないときは null。** 通ったものが 2 枚未満か、
    // 星が上限に達しているとき。
    Session? next_round(
        Session previous,
        sequence<PhotoRef> photos,
        boolean group_bursts,
        BurstThreshold threshold,
        sequence<PairOverride> overrides
    );

    // 同じ星の写真だけで、もう一度ラウンドを作る。**終わったあとでも呼べる。**
    // 星が上限か、その星が 2 枚未満なら null。
    Session? round_for(
        Session previous,
        sequence<PhotoRef> photos,
        i32 star,
        boolean group_bursts,
        BurstThreshold threshold,
        sequence<PairOverride> overrides
    );

    // ---- 保存 ----
    // 保存の形は core が持つ。各環境が独自に組み立てない。
    string session_to_json(Session session);
    Session? session_from_json(string json);

    // ---- サイドカー（.photo-curator/catalog.json）の同期（U33） ----
    // 判断は core の 1 か所。PC・Web（wasm）と同じ規則で動く。Android の呼び出しの
    // 切り替えは U35（いまはまだ Kotlin の Sidecar.kt が使われている）。
    // 形は core が持つ。壊れていたら null（中途半端に読んで上書きしない）。
    string sidecar_to_json(Sidecar sidecar);
    Sidecar? sidecar_from_json(string json);

    // 写真の鍵をそろえる（区切り `/`・NFC）。
    string normalize_key(string key);

    // 選別状況（星・セッション・手直し・学習した境目）の正規形。**ここに無いものは比べない。**
    // 星は Session があれば session.ratings、無ければ photos。★0 は持たない。
    Judgement canonical_judgement(
        Session? session,
        record<DOMString, i32> photos,
        sequence<PairOverride> overrides,
        u32? burst_distance,
        string? epoch
    );
    Judgement sidecar_judgement(Sidecar sidecar);
    // 意味として同じか。JSON の並び・空白・updatedAt・updatedBy・writeId では違わない。
    boolean judgement_equivalent(Judgement a, Judgement b);
    // 比較キー（正規形の SHA-256）。画像のハッシュ値とは別物。
    string judgement_key(Judgement judgement);
    // 未着手か（★1 以上が無い・1 手も進んでいない・手直しも境目も無い）。
    boolean is_untouched(Judgement judgement);
    SidecarProgress judgement_progress(Judgement judgement);
    // どちらが進んでいるか（表示用。自動の判断には使わない）。
    ProgressOrder progress_cmp(SidecarProgress a, SidecarProgress b);

    // 版の見分け（writeId。無ければ legacy:<updatedAt>:<updatedBy>）。
    string sidecar_token(Sidecar sidecar);
    // その版を見たときの控え（取り込んだあと・意味が同じだったとき）。
    SeenRecord sidecar_seen(Sidecar sidecar);
    // 開き方の判断。remote は読めたもの（無ければ null）。つながらないときは呼ばない。
    SidecarPlan sidecar_plan(
        SeenRecord seen,
        Judgement local,
        Sidecar? remote,
        boolean writable,
        boolean detached
    );
    // 書く直前に v2 の印（version・writeId・basedOn・lineage・keyBase・progress）を入れる。
    // 設定は base にあって sidecar に無いもの（未知の設定など）を引き継ぐ（U48）。
    Sidecar sidecar_stamp(Sidecar sidecar, string write_id, Sidecar? base);

    // U48: プロジェクトの設定（pairRawJpeg）をどうするか。どちらかが無ければある方、
    // 値が同じなら何もしない、違えば切り替えた時刻（at）が新しい方、同じ時刻なら NAS。
    SettingsPlan settings_resolve(SettingsRecord? local, SettingsRecord? remote);

    // 混ぜる（ダイアログの D・E）。
    record<DOMString, i32> merge_stars(Judgement mine, Judgement theirs, MergeMode mode);
    sequence<PairOverride> merge_overrides(sequence<PairOverride> mine, sequence<PairOverride> theirs);
    Session session_from_ratings(
        record<DOMString, i32> ratings,
        u32 round,
        i32 target_star,
        u32 group_size,
        record<DOMString, sequence<string>> members
    );
    MergeResult merge_judgements(
        Judgement mine,
        Judgement theirs,
        MergeMode mode,
        u32 group_size,
        string fresh_epoch
    );
    MergePreview merge_preview(Judgement mine, Judgement theirs);

    // 写真の鍵の変換（サイドカーは「選んだフォルダからの相対・`/`」）。
    Sidecar sidecar_keys_to_folder(Sidecar sidecar, string prefix);
    Sidecar sidecar_keys_from_folder(Sidecar sidecar, string prefix, string separator);
    // 読んだ直後に通す。keyBase が無い古い版は、頭のフォルダが folder_hint の末尾と合えば外す。
    Sidecar sidecar_normalize_keys(Sidecar sidecar, string folder_hint);
    KeyCoverage sidecar_key_coverage(Sidecar sidecar, sequence<string> photo_keys);

    // ---- 写真のファイル名（R10） ----
    // 3 台で同じでなければ困る規則だけ。どの名前を候補にするか（拡張子の一覧）は各環境が持つ（B8）。
    // 道筋の区切りは `/` でも `\` でもよい。先頭の点は拡張子にしない。
    // 拡張子が RAW か（大文字小文字は問わない。HEIC・HEIF は RAW ではない）。
    boolean is_raw_name([ByRef] string name);
    // RAW の拡張子の一覧（小文字）。
    sequence<string> raw_extensions();
    // 道筋ごとに「同じフォルダに同名（大文字小文字を無視）の JPEG がある RAW なので除く」なら true。
    // 並びは入力と同じ。呼ぶ側が自分の一覧を並びを保って絞るための形。
    sequence<boolean> paired_raw_mask(sequence<string> paths);
    // 組の RAW を除いた道筋の一覧（並びは保つ）。enabled が false なら何も除かない。
    sequence<string> skip_paired_raw(sequence<string> paths, boolean enabled);
};

// 選別に出す 1 枚。**端末ごとの指し先は持たない。**
dictionary PhotoRef {
    // 共有の鍵。フォルダ内の相対パス。
    string relative_path;
    // 撮影時刻（ミリ秒）。読めなかったものは連写のまとめに出さない。
    i64? captured_at;
    // 64bit を 16 桁の 16 進で。読めなかったものは null。
    string? d_hash;
    i32 d_hash_version;
};

dictionary BurstPair {
    PhotoRef left;
    PhotoRef right;
};

// まとめる基準。**利用者が学習させた値がここに入る。**
dictionary BurstThreshold {
    // これ以内なら「時間が近い」。既定 4 秒。
    i64 window_ms;
    // これ以内なら「見た目が近い」。小さいほど厳しい。
    u32 distance;
    // 比べてよい dHash の版。合わないものは比べない。
    i32 d_hash_version;
};

// 人が手で直したまとめ方。**まとまりそのものは閾値から導くので持たない。**
dictionary PairOverride {
    string left;
    string right;
    // "split" は切る、"join" は繋ぐ。
    string decision;
};

// 学習の 1 問への答え。**距離と、人の判断だけ。**
dictionary BurstAnswer {
    u32 distance;
    boolean same;
};

dictionary BurstGroup {
    sequence<string> members;
    // 代表。既定は先頭だが、人が変えられる。
    string representative;
};

// ---------------------------------------------------------------------------
// 選別。**3 環境で同じ答えでなければ困るので core に置く。**
// ---------------------------------------------------------------------------

// 選別の途中。**丸ごと保存して、丸ごと読み戻す。**
// どこで止めても失わないよう、確定のたびにこれを書く。
dictionary Session {
    u32 group_size;
    i32 target_star;
    u32 round;
    // まだ見ていない代表。撮影順。
    sequence<string> queue;
    // いま画面に出ている代表。
    sequence<string> current;
    // このラウンドを通ったもの。
    sequence<string> survivors;
    // 星。代表だけでなく、まとまりの仲間も含む。
    record<DOMString, i32> ratings;
    // まとまり。キーが代表、値が仲間（代表を含む）。
    record<DOMString, sequence<string>> members;
    // 1 つ戻す用。**ラウンドをまたげる形にしてある。**
    sequence<Decision> history;
    // 全部見終わったか。
    boolean finished;
};

dictionary Decision {
    sequence<string> group;
    sequence<string> chosen;
    // ★5 で確定したなら、その 1 枚と押す前の星。戻すときに使う。
    Topped? topped;
    // 確定の前の星の控え（写真 → 確定の前の星）。戻すときはこの値を書き戻す。
    // 空なら古い形の履歴で、差分で戻す。
    record<DOMString, i32> before;
};

dictionary Topped {
    string path;
    i32 previous;
};

// ---------------------------------------------------------------------------
// サイドカー（U33）。形は core の Sidecar と同じ（JSON の名前は camelCase）。
// ---------------------------------------------------------------------------

dictionary SidecarPhoto {
    i32 rating;
};

dictionary SidecarSessions {
    Session? tournament;
};

dictionary Sidecar {
    i32 version;
    i64 updated_at;
    string updated_by;
    string updated_by_name;
    // 写真の鍵（選んだフォルダからの相対）→ 星。
    record<DOMString, SidecarPhoto> photos;
    sequence<PairOverride> burst_overrides;
    SidecarSessions sessions;
    u32? burst_distance;
    // v2 で足した項目。すべて省略できる。
    string? write_id;
    string? based_on;
    sequence<string>? lineage;
    string? epoch;
    string? key_base;
    SidecarProgress? progress;
    // U48: プロジェクトの設定（比較キー・意味が同じかには入れない）。古い呼び出し側のため既定は null。
    SettingsRecord? settings = null;
};

// U48: 真偽の設定 1 つ。at は切り替えた時刻（ms）。0 は「作ったまま一度も切り替えていない」。
dictionary SettingValueBool {
    boolean value;
    i64 at;
};

// U48: catalog.json の settings。知らない設定は other に「名前 → 値の JSON 文字列」で持ち、書き戻す。
dictionary SettingsRecord {
    SettingValueBool? pair_raw_jpeg = null;
    // uniffi 0.28 は {} の既定値を書けない。Kotlin では other = emptyMap() を渡す。
    record<DOMString, string> other;
};

// U48: 設定をどうするか（settings_resolve）。今は pairRawJpeg だけ。
[Enum]
interface SettingsPlan {
    Keep();
    AdoptRemote(boolean value, i64 at);
    PushLocal();
};

// 判断と画面のための要約（Session から作り直せる値）。
dictionary SidecarProgress {
    boolean started;
    u32 round;
    boolean finished;
    u32 decided;
    u32 remaining;
    u32 starred;
    u32? total;
    u32 overrides;
    boolean learned;
};

dictionary PhotoStar {
    string path;
    i32 rating;
};

dictionary MemberGroup {
    string representative;
    sequence<string> members;
};

dictionary JudgementDecision {
    sequence<string> group;
    sequence<string> chosen;
    string? topped;
};

// セッションの正規形。1 組の枚数は持たない（表示の設定なので比べない）。
dictionary JudgementSession {
    u32 round;
    i32 target_star;
    boolean finished;
    sequence<string> remaining;
    sequence<string> survivors;
    sequence<MemberGroup> members;
    sequence<JudgementDecision> history;
};

// 選別状況の正規形。
dictionary Judgement {
    sequence<PhotoStar> stars;
    JudgementSession? session;
    sequence<PairOverride> overrides;
    u32? burst_distance;
    string? epoch;
    // その端末の記録にある写真（★0 も含む）。積集合で「記録に無い＝未判定」を見分けるだけ（D3）。
    // 意味が同じかの判断と比較キーには入れない。null は全部を記録にあると見なす。
    sequence<string>? known = null;
};

// 端末の控え（最後に読んだ／書いた版）。一度も見ていなければ token は空。
// key が空なら「端末に変更あり」と見なす。
dictionary SeenRecord {
    string token;
    string key;
    string? epoch;
};

enum SettledReason { "Nothing", "Same", "NoChange", "Detached", "ReadOnly", "NewerVersion" };
enum PushReason { "NoSidecar", "LocalChanged", "TheirsUntouched", "MineHasMore" };
enum PullReason { "LocalUntouched", "FastForward", "TheirsHasMore" };
enum ClashReason { "Diverged", "TheirsRestarted", "MineRestarted", "ExtrasConflict" };
enum ProgressOrder { "Ahead", "Behind", "Even", "Unclear" };
enum MergeMode { "Intersection", "Union" };

dictionary MergePreview {
    u32 mine_starred;
    u32 theirs_starred;
    u32 intersection_starred;
    u32 union_starred;
    u32 undecided;
    boolean mid_round;
    // U45: 途中の ROUND があるのに ROUND か対象の★が違えば false（D・E を出さない）。
    boolean mergeable;
};

dictionary MergeResult {
    Session session;
    record<DOMString, i32> ratings;
    sequence<PairOverride> overrides;
    u32? burst_distance;
    string? epoch;
    u32 starred;
    u32 undecided;
};

dictionary KeyCoverage {
    u32 matched;
    u32 total;
};

// 開き方の判断。Settled（何もしない）／Push（書く）／Pull（確認なしに取り込む）／
// Clash（両方の要約を出して 5 択で選ばせる）。
[Enum]
interface SidecarPlan {
    Settled(SeenRecord? seen, SettledReason reason);
    Push(string? expected, boolean aside_theirs, PushReason reason);
    Pull(Sidecar theirs, boolean aside_mine, SeenRecord seen, PullReason reason);
    Clash(
        Sidecar theirs,
        SidecarProgress mine_progress,
        SidecarProgress theirs_progress,
        ProgressOrder order,
        ClashReason reason,
        MergePreview preview
    );
};
